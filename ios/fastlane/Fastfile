require "json"
require "tmpdir"
require "base64"
require "securerandom"

default_platform(:ios)
platform :ios do
  desc "Archive and upload the native Swift app; no tests are run"
  lane :beta do
    team = ENV.fetch("APPLE_TEAM_ID")
    bundle = ENV.fetch("IOS_BUNDLE_ID")
    build = ENV.fetch("IOS_BUILD_NUMBER")
    UI.user_error!("Invalid build configuration") unless team.match?(/\A[A-Z0-9]{10}\z/) && bundle == "app.pccontrol.remote" && build.match?(/\A\d+(?:\.\d+){0,2}\z/)
    signing = JSON.parse(File.read(ENV.fetch("PC_CONTROL_SIGNING_BUNDLE")))
    dir = File.dirname(ENV.fetch("PC_CONTROL_SIGNING_BUNDLE"))
    key = File.join(dir,"AuthKey.p8")
    File.write(key,signing.fetch("privateKey"),perm:0600)
    api_key = app_store_connect_api_key(key_id:signing.fetch("keyId"),issuer_id:signing.fetch("issuerId"),key_filepath:key,duration:1200,in_house:false)
    app = Spaceship::ConnectAPI::App.find(bundle)
    UI.user_error!("App Store Connect record missing for #{bundle}") unless app
    keychain_password = SecureRandom.hex(24)
    create_keychain(name:"pccontrol_build",password:keychain_password,default_keychain:true,unlock:true,timeout:3600,lock_when_sleeps:false)
    p12 = File.join(dir,"Distribution.p12")
    File.binwrite(p12,Base64.strict_decode64(signing.fetch("p12"))); File.chmod(0600,p12)
    import_certificate(certificate_path:p12,certificate_password:signing.fetch("p12Password"),keychain_name:"pccontrol_build",keychain_password:keychain_password)
    get_provisioning_profile(api_key:api_key,app_identifier:bundle,team_id:team,cert_id:signing.fetch("certificateId"),provisioning_name:"PC Control TestFlight",force:true,output_path:dir)
    profile = lane_context[SharedValues::SIGH_NAME]
    UI.user_error!("No provisioning profile installed") if profile.to_s.empty?
    ipa = build_app(
      project:"PCControl/PCControl.xcodeproj",scheme:"PCControl",configuration:"Release",clean:true,export_method:"app-store",
      output_directory:"build",output_name:"PCControl.ipa",skip_profile_detection:true,
      xcargs:"DEVELOPMENT_TEAM=#{team} PRODUCT_BUNDLE_IDENTIFIER=#{bundle} CURRENT_PROJECT_VERSION=#{build} CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='#{profile.gsub("'","")}'",
      export_options:{signingStyle:"manual",teamID:team,provisioningProfiles:{bundle=>profile},manageAppVersionAndBuildNumber:false,uploadSymbols:true}
    )
    upload_to_testflight(api_key:api_key,app_identifier:bundle,ipa:ipa,skip_waiting_for_build_processing:true,skip_submission:true,distribute_external:false)
  end
end
